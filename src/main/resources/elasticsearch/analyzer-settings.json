{
  "analysis": {
    "analyzer": {
      "french_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "french_elision",
          "french_stop",
          "french_stemmer"
        ]
      }
    },
    "filter": {
      "french_stop": {
        "type": "stop",
        "stopwords": "_french_"
      },
      "french_stemmer": {
        "type": "stemmer",
        "language": "light_french"
      },
      "french_elision": {
        "type": "elision",
        "articles": ["l", "m", "t", "qu", "n", "s", "j", "d", "c", "jusqu", "quoiqu", "lorsqu", "puisqu"]
      }
    }
  }
}